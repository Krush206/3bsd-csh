#	$OpenBSD: Makefile,v 1.10 2010/01/04 17:50:36 deraadt Exp $
#
# C Shell with process control; VM/UNIX VAX Makefile
# Bill Joy UC Berkeley; Jim Kulp IIASA, Austria
#
# To profile, put -DPROF in DEFS and -pg in CFLAGS, and recompile.

PROG=	csh
DFLAGS=-DBUILTIN -DNLS -DSHORT_STRINGS
#CFLAGS+=-g
#CFLAGS+=-Wall
CFLAGS+=-I${.CURDIR} -I. ${DFLAGS}
SRCS=	alloc.c char.c const.c csh.c dir.c dol.c error.c exec.c exp.c \
	func.c glob.c hist.c init.c lex.c misc.c parse.c proc.c \
	sem.c set.c str.c time.c
OBJ = $(SRCS:.c=.o)

all: const.h $(OBJ)
	$(CC) -o $(PROG) $(OBJ) $(LDFLAGS) $(LIBS)
	$(STRIP) ./$(PROG)

%.o: %.c
	$(CC) -c $(CFLAGS) $<

clean:
	rm -f errnum.h const.h ./*.o ./$(PROG)

error.h: error.c
	( echo '/* Do not edit this file, make creates it. */' ; \
	echo '#ifndef _h_sh_errnum' ; \
	echo '#define _h_sh_errnum' ; \
	egrep 'ERR_' $(SRCS) | egrep '^#define' ; \
	egrep 'ERR_' $(PWD)/*.[ch] | egrep '#define' | \
	sed -e 's/.*#define/#define/' ; \
	echo '#endif /* _h_sh_errnum */' ) > $@

const.c: error.h
const.h: const.c
	echo '/* Do not edit this file, make creates it. */' > $@
	$(CC) -E $(CFLAGS) $(PWD)/*.[ch] | egrep 'Char STR' | \
	sed -e 's/Char \([a-zA-Z0-9_]*\)\(.*\)/extern Char \1[];/' \
	-e 's/.*extern/extern/' | sort >> $@
